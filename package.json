{
  "name": "elitea",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client",
    "build:client": "esbuild src/browser-app.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=none --outfile=public/app.js && esbuild src/browser-cloud.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=none --outfile=public/cloud.js && node scripts/clean-generated-assets.mjs",
    "build:everand": "node scripts/build-everand-knowledge.mjs",
    "eval:roles": "node scripts/evaluate-ai-roles.mjs",
    "eval:public-coach": "node scripts/evaluate-public-coach-test.mjs",
    "qa:academy-production": "node scripts/qa-production-academy-e2e.mjs",
    "audit:courses": "node scripts/audit-course-depth.mjs",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.74",
    "express": "^5.1.0",
    "jose": "^6.2.10",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
